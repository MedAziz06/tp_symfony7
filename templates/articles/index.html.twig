{% extends 'base.html.twig' %}

{% block body %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-8">
            {{ form_row(form.nom) }}
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Rechercher</button>
        </div>
    </div>
    {{ form_end(form) }}

    {% if articles|length > 0 %}
        <table class="table table-striped mt-4">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>Catégorie</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.nom }}</td>
                        <td>{{ article.prix }} €</td>
                        <td>{{ article.category.titre }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="alert alert-warning mt-4">
            Aucun article trouvé pour votre recherche.
            <a href="{{ path('article_list') }}" class="alert-link">Réinitialiser la recherche</a>
        </div>
    {% endif %}
{% endblock %}